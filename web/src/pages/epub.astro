---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ToolShell from '../components/ToolShell.astro';
import EpTool from '../components/EpTool.astro';
import Footer from '../components/Footer.astro';
import { ui, localizedPath } from '../i18n/ui';

const lang = 'en';
const t = ui[lang].tools;
const backLabel = t.backLabel;
const backHref = localizedPath('/tools', lang);
---

<Layout
  lang={lang}
  title="Book Info & Cover — OnePage · 壹頁"
  description="Read EPUB / TXT metadata (title, author, language, publisher, chapters) and turn the embedded cover into a 480×800 e-ink bitmap — 1-bit dithered or 4-level grayscale. Unzipped and parsed entirely in your browser."
>
  <Nav lang={lang} />
  <main>
    <ToolShell
      lang={lang}
      surface="light"
      eyebrow={t.items.epub.name}
      title={t.items.epub.name}
      lede={t.items.epub.tagline}
      backLabel={backLabel}
      backHref={backHref}
    >
      <EpTool lang={lang} />
    </ToolShell>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
