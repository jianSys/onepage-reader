---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ToolShell from '../../components/ToolShell.astro';
import ImageTool from '../../components/ImageTool.astro';
import Footer from '../../components/Footer.astro';
import { ui, localizedPath } from '../../i18n/ui';

const lang = 'en';
const t = ui[lang].tools;
const backLabel = t.backLabel;
const backHref = localizedPath('/tools', lang);
---

<Layout
  lang={lang}
  title="Image → BMP — OnePage · 壹頁"
  description="Turn any photo into a 480×800 e-ink bitmap — 1-bit dithered or 4-level grayscale — ready to drop on the SD card or push over Wi-Fi. Runs entirely in your browser."
>
  <Nav lang={lang} />
  <main>
    <ToolShell
      lang={lang}
      surface="light"
      eyebrow={t.items.images.name}
      title={t.items.images.name}
      lede={t.items.images.tagline}
      backLabel={backLabel}
      backHref={backHref}
    >
      <ImageTool lang={lang} />
    </ToolShell>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
