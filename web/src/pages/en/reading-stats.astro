---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ToolShell from '../../components/ToolShell.astro';
import StatsBoardTool from '../../components/StatsBoardTool.astro';
import Footer from '../../components/Footer.astro';
import { ui, localizedPath } from '../../i18n/ui';

const lang = 'en';
const t = ui[lang].tools;
const backLabel = t.backLabel;
const backHref = localizedPath('/tools', lang);
---

<Layout
  lang={lang}
  title="Reading Stats — OnePage · 壹頁"
  description="Connect to your OnePage reader and turn its cumulative reading time, sessions and page turns into a dashboard with pace metrics and a per-day reading trend. Data is read straight from the device’s /api/stats — all in your browser."
>
  <Nav lang={lang} />
  <main>
    <ToolShell
      lang={lang}
      surface="light"
      eyebrow={t.items.readingStats.name}
      title={t.items.readingStats.name}
      lede={t.items.readingStats.tagline}
      backLabel={backLabel}
      backHref={backHref}
    >
      <StatsBoardTool lang={lang} />
    </ToolShell>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
