---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ToolShell from '../../components/ToolShell.astro';
import Txt2EpubTool from '../../components/Txt2EpubTool.astro';
import Footer from '../../components/Footer.astro';
import { ui, localizedPath } from '../../i18n/ui';

const lang = 'en';
const t = ui[lang].tools;
const backLabel = t.backLabel;
const backHref = localizedPath('/tools', lang);
---

<Layout
  lang={lang}
  title="TXT → EPUB — OnePage · 壹頁"
  description="Pack a plain-text book into a real EPUB with a cover and a chapter outline — encoding repair, ad stripping and regex chapter splitting, all in your browser. Download to the SD card or push over Wi-Fi."
>
  <Nav lang={lang} />
  <main>
    <ToolShell
      lang={lang}
      surface="light"
      eyebrow={t.items.txt2epub.name}
      title={t.items.txt2epub.name}
      lede={t.items.txt2epub.tagline}
      backLabel={backLabel}
      backHref={backHref}
    >
      <Txt2EpubTool lang={lang} />
    </ToolShell>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
