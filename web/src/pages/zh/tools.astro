---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import ToolHub from '../../components/ToolHub.astro';
import Footer from '../../components/Footer.astro';

const lang = 'zh';
---

<Layout
  lang={lang}
  title="工具台 — 壹頁 · OnePage"
  description="为你的壹頁阅读器准备的浏览器本地工具：墨水屏卡片工坊、字体转换器，还有更多。全部在本地运行，什么都不上传。"
>
  <Nav lang={lang} />
  <main>
    <ToolHub lang={lang} />
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
