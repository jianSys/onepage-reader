---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { localizedPath } from '../i18n/ui';

const lang = 'zh';
const home = localizedPath('/', lang);
// No /en/404/ page exists, so send the language switch to the en home instead of a dead loop.
const enHome = localizedPath('/', 'en');
---

<Layout
  lang={lang}
  title="页面未找到 — 壹頁 · OnePage"
  description="这一页不存在。返回壹頁 · OnePage。"
  noindex
>
  <Nav lang={lang} switchHrefOverride={enHome} />
  <main class="flex min-h-[calc(100dvh-3.5rem)] flex-col items-center justify-center px-6 text-center">
    <Logo class="h-28 w-auto text-ink/80 sm:h-32" />
    <p class="mt-10 font-serif text-7xl font-medium tracking-tight text-ink sm:text-8xl">404</p>
    <h1 class="mt-5 max-w-[22ch] font-serif text-2xl font-medium tracking-tight text-balance text-ink sm:text-3xl">
      这一页翻成了空白。
    </h1>
    <p class="mt-4 max-w-[42ch] text-base/7 text-pretty text-ink/55">
      页面没找到 —— 链接可能已过期或输入有误。
    </p>
    <a
      href={home}
      class="mt-10 rounded-full border border-ink/20 px-5 py-2 font-mono text-sm text-ink/85 no-underline transition hover:border-ink/40 hover:text-ink"
    >← 返回壹頁 · OnePage</a>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
