---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import ToolShell from '../components/ToolShell.astro';
import CardStudio from '../components/CardStudio.astro';
import Footer from '../components/Footer.astro';
import { ui, localizedPath } from '../i18n/ui';

const lang = 'zh';
const c = ui[lang].cards;
const backLabel = ui[lang].tools.backLabel;
const backHref = localizedPath('/tools', lang);
---

<Layout
  lang={lang}
  title="卡片工坊 — 壹頁 · OnePage"
  description="在浏览器里为 OnePage 的 AirPage 设计 480×800 墨水屏卡片（一言、天气、状态、待办），实时抖动成真实黑白效果，可下载为即用的 BMP 图片或通过 Wi-Fi 推送到设备。"
>
  <Nav lang={lang} />
  <main>
    <ToolShell
      lang={lang}
      surface="light"
      eyebrow={c.eyebrow}
      title={c.title}
      lede={c.lede}
      backLabel={backLabel}
      backHref={backHref}
    >
      <CardStudio lang={lang} />
    </ToolShell>
  </main>
  <Footer lang={lang} showAbout={false} />
</Layout>
