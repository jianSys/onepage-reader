---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const chapterDefault =
  '^\\s*(?:第\\s*[0-9一二三四五六七八九十百千万零〇两]+\\s*[章节回卷篇折]|序章|楔子|前言|引子|尾声|后记|番外|终章|Chapter\\s+\\d+|PROLOGUE|EPILOGUE)';

const strings = {
  pick: zh ? '选择或拖入一个 .txt 文件' : 'Choose or drop a .txt file',
  noFile: zh ? '请先选择一个 TXT 文件。' : 'Pick a TXT file first.',
  processing: zh ? '正在处理…' : 'Processing…',
  ready: zh ? '就绪。' : 'Ready.',
  pushed: zh ? '已推送到设备。' : 'Pushed to device.',
  pushFailed: zh ? '推送失败，请检查设备地址与网络。' : 'Push failed — check the device address and network.',
  deviceChecking: zh ? '检测中…' : 'Checking…',
  deviceOnline: zh ? '设备在线。' : 'Device online.',
  deviceOffline: zh ? '设备离线或未填写地址。' : 'Device offline or address missing.',
  dlLabel: zh ? '下载整理后的 TXT' : 'Download cleaned TXT',
  lblChars: zh ? '字符' : 'chars',
  lblLines: zh ? '行数' : 'lines',
  lblChapters: zh ? '章节' : 'chapters',
  lblSize: zh ? '大小' : 'size',
  lblEncoding: zh ? '编码' : 'encoding',
  autoLabel: zh ? '自动检测' : 'Auto-detect',
  loaded: '',
  previewEmpty: zh ? '整理后的正文预览会显示在这里。' : 'The tidied text preview shows up here.',
};

const L = {
  encTitle: zh ? '编码' : 'Encoding',
  encHint: zh
    ? '选「自动检测」会先按 UTF-8 严格解码，失败再回退常见中日韩代码页。'
    : 'Auto-detect tries strict UTF-8 first, then falls back to common CJK code pages.',
  tidyTitle: zh ? '整理选项' : 'Tidying options',
  optStripAds: zh ? '去除广告 / 水印行' : 'Strip ad / watermark lines',
  optCollapse: zh ? '合并多余空行' : 'Collapse extra blank lines',
  optTrim: zh ? '去除行尾空格' : 'Trim trailing whitespace',
  customTitle: zh ? '自定义去除规则（每行一个正则，可选）' : 'Custom strip patterns (one regex per line, optional)',
  customPh: zh ? '例如：^\s*（本章.*）$' : 'e.g. ^\s*(site watermark…)$',
  chapterTitle: zh ? '章节识别' : 'Chapter detection',
  chapterOn: zh ? '启用分章统计与目录预览' : 'Detect chapters for the stats and TOC preview',
  chapterRe: zh ? '章节标题正则' : 'Chapter heading regex',
  previewTitle: zh ? '预览' : 'Preview',
  tocTitle: zh ? '识别到的章节' : 'Detected chapters',
  deviceLabel: zh ? '设备地址' : 'Device address',
  destLabel: zh ? '保存目录' : 'Save folder',
  probeBtn: zh ? '探测' : 'Probe',
  downloadBtn: zh ? '下载 TXT' : 'Download',
  pushBtn: zh ? '推送到设备' : 'Push to device',
  offlineNote: zh
    ? '整理全部在你的浏览器本地完成，原文不会上传。推送走设备内置 Web 服务的 /upload 接口，把干净的 UTF-8 TXT 写进 SD 卡目录。'
    : 'All tidying happens locally in your browser — nothing is uploaded. Push uses the device’s built-in /upload endpoint to write a clean UTF-8 TXT to a folder on the SD card.',
  footNote: zh
    ? '说明：本工具只做文本层面的整理（编码修复、去广告、规整空行、章节识别与统计）。阅读进度所需的 index.bin 由固件在设备上生成，浏览器无法可靠复刻，故不在此提供。'
    : 'Note: this tool only tidies the text (encoding fix, ad-strip, blank-line cleanup, chapter detection & stats). The index.bin used for reading progress is generated on-device by the firmware and cannot be faithfully reproduced in a browser, so it is intentionally not offered here.',
};
---

<section class="tx py-6 sm:py-8" data-txt={JSON.stringify({ strings })}>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        {/* Dropzone */}
        <div id="txDrop" class="tx-drop" tabindex="0" role="button" aria-label={strings.pick}>
          <svg class="tx-drop-icon" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2h9l3 3v17H6z M14 2v4h4 M9 12h6 M9 16h6" />
          </svg>
          <p class="tx-drop-title" id="txPick">{strings.pick}</p>
          <p class="tx-drop-sub">{zh ? '本地解码与整理，绝不上传。' : 'Decoded and tidied locally — never uploaded.'}</p>
          <span id="txFileName" class="tx-filename"></span>
        </div>
        <input id="txFile" type="file" accept=".txt,text/plain" class="hidden" />

        {/* Encoding */}
        <h2 class="tx-h2">{L.encTitle}</h2>
        <select id="txEncoding" class="tx-control mt-3">
          <option value="auto">{zh ? '自动检测' : 'Auto-detect'}</option>
          <option value="utf-8">UTF-8</option>
          <option value="gb18030">GBK / GB18030</option>
          <option value="big5">Big5</option>
          <option value="shift_jis">Shift_JIS</option>
          <option value="euc-kr">EUC-KR</option>
          <option value="windows-1252">Windows-1252 / Latin-1</option>
        </select>
        <p class="tx-hint">{L.encHint}</p>

        {/* Tidying options */}
        <h2 class="tx-h2">{L.tidyTitle}</h2>
        <div class="mt-3 grid gap-2.5">
          <label class="tx-check"><input id="txStripAds" type="checkbox" checked /> <span>{L.optStripAds}</span></label>
          <label class="tx-check"><input id="txCollapse" type="checkbox" checked /> <span>{L.optCollapse}</span></label>
          <label class="tx-check"><input id="txTrim" type="checkbox" checked /> <span>{L.optTrim}</span></label>
        </div>
        <textarea id="txAdCustom" class="tx-control tx-area mt-3" rows="3" placeholder={L.customPh} aria-label={L.customTitle}></textarea>
        <p class="tx-hint">{L.customTitle}</p>

        {/* Chapter detection */}
        <h2 class="tx-h2">{L.chapterTitle}</h2>
        <label class="tx-check mt-3"><input id="txChapterOn" type="checkbox" checked /> <span>{L.chapterOn}</span></label>
        <label class="tx-field mt-3">
          <span class="tx-flabel">{L.chapterRe}</span>
          <input id="txChapterRe" type="text" value={chapterDefault} class="tx-control tx-mono" />
        </label>
      </div>

      {/* Preview + stats + device */}
      <div>
        <p id="txStats" class="tx-stats"></p>
        <h2 class="tx-h2 mt-6">{L.previewTitle}</h2>
        <pre id="txPreview" class="tx-preview mt-3">{strings.previewEmpty}</pre>

        <div id="txTocWrap">
          <h2 class="tx-h2">{L.tocTitle}</h2>
          <ul id="txToc" class="tx-toc mt-3"></ul>
        </div>

        {/* Device */}
        <div class="mt-8">
          <label class="tx-field">
            <span class="tx-flabel">{L.deviceLabel}</span>
            <div class="flex items-center gap-2">
              <input id="txDevice" type="text" value="http://192.168.4.1" class="tx-control flex-1" />
              <button id="txProbe" type="button" class="tx-btn tx-btn-ghost shrink-0">{L.probeBtn}</button>
            </div>
          </label>
          <label class="tx-field mt-3">
            <span class="tx-flabel">{L.destLabel}</span>
            <input id="txDest" type="text" value="/books" class="tx-control" />
          </label>
          <p id="txDeviceStatus" class="mt-2 font-mono text-xs text-ink/50"></p>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <button id="txDownload" type="button" class="tx-btn tx-btn-ghost">{L.downloadBtn}</button>
          <button id="txPush" type="button" class="tx-btn tx-btn-primary">{L.pushBtn}</button>
        </div>
        <p id="txStatus" class="mt-4 font-mono text-xs text-ink/60">{strings.ready}</p>
        <p class="mt-2 max-w-[60ch] text-xs/5 text-ink/45">{L.offlineNote}</p>
      </div>
    </div>

    <p class="mt-12 border-t border-ink/10 pt-4 text-xs/5 text-ink/40">{L.footNote}</p>
  </div>
</section>

<style>
  .tx-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    cursor: pointer;
    border: 1.5px dashed color-mix(in oklab, var(--color-ink) 22%, transparent);
    border-radius: 16px;
    background: var(--color-surface);
    padding: 30px 20px;
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .tx-drop:hover,
  .tx-drop:focus-visible,
  .tx-drop.dragover {
    border-color: var(--color-accent-500);
    background: color-mix(in oklab, var(--color-accent-500) 6%, var(--color-surface));
    outline: none;
  }
  .tx-drop.has-file {
    padding: 14px 20px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }
  .tx-drop.has-file .tx-drop-icon,
  .tx-drop.has-file .tx-drop-sub {
    display: none;
  }
  .tx-drop.has-file .tx-drop-title::after {
    content: ' ✓';
    color: var(--color-accent-600);
  }
  .tx-drop-icon {
    color: var(--color-accent-600);
  }
  .tx-drop-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-ink);
  }
  .tx-drop-sub {
    font-size: 13px;
    color: color-mix(in oklab, var(--color-ink) 55%, transparent);
  }
  .tx-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in oklab, var(--color-ink) 50%, transparent);
  }

  .tx-h2 {
    margin-top: 30px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-600);
  }
  .tx-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tx-flabel {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-ink) 50%, transparent);
  }
  .tx-control {
    width: 100%;
    border: 1px solid color-mix(in oklab, var(--color-ink) 15%, transparent);
    background: #ffffff;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: var(--color-ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .tx-control:focus {
    border-color: var(--color-accent-500);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent-500) 25%, transparent);
  }
  .tx-mono {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .tx-area {
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
  }
  .tx-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .tx-check input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent-600);
  }
  .tx-hint {
    margin-top: 10px;
    font-size: 12px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-ink) 45%, transparent);
  }

  .tx-stats {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-accent-600);
    min-height: 1.2em;
  }
  .tx-preview {
    max-height: 420px;
    overflow: auto;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    border-radius: 12px;
    background: #ffffff;
    padding: 16px 18px;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-ink);
  }
  .tx-toc {
    max-height: 260px;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tx-toc-item {
    font-size: 13px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-ink) 78%, transparent);
    border-bottom: 1px dashed color-mix(in oklab, var(--color-ink) 10%, transparent);
    padding: 3px 0;
  }
  .tx-toc-more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in oklab, var(--color-ink) 40%, transparent);
    padding: 3px 0;
  }

  .tx-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    border-radius: 999px;
    padding: 9px 18px;
    cursor: pointer;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .tx-btn-ghost {
    border: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
    background: #ffffff;
    color: var(--color-ink);
  }
  .tx-btn-ghost:hover {
    border-color: var(--color-accent-500);
    color: var(--color-accent-600);
  }
  .tx-btn-primary {
    border: 1px solid var(--color-accent-600);
    background: var(--color-accent-600);
    color: var(--color-surface);
    font-weight: 600;
  }
  .tx-btn-primary:hover {
    background: var(--color-accent-700);
    border-color: var(--color-accent-700);
  }
</style>

<script>
  import { initTxtTool } from '../tools/txt';

  const section = document.querySelector('[data-txt]');
  if (section) {
    const props = JSON.parse(section.getAttribute('data-txt') || '{}');
    initTxtTool(props);
  }
</script>
