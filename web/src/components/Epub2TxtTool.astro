---
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh';

const strings = {
  noFile: zh ? '请先选择一个 EPUB 文件。' : 'Pick an EPUB file first.',
  processing: zh ? '正在解析…' : 'Parsing…',
  ready: zh ? '就绪。' : 'Ready.',
  parsed: zh ? '已读取 {chapters} 章。' : 'Read {chapters} chapters.',
  empty: zh ? '没有解析到正文，可能是非标准 EPUB。' : 'No body text found — this may not be a standard EPUB.',
  built: zh ? '已生成 TXT（{chars} 字）。' : 'TXT built ({chars} chars).',
  pushed: zh ? '已推送到设备。' : 'Pushed to device.',
  pushFailed: zh ? '推送失败，请检查设备地址与网络。' : 'Push failed — check the device address and network.',
  deviceChecking: zh ? '检测中…' : 'Checking…',
  deviceOnline: zh ? '设备在线。' : 'Device online.',
  deviceOffline: zh ? '设备离线或未填写地址。' : 'Device offline or address missing.',
  previewEmpty: zh ? '章节目录会显示在这里。' : 'The chapter outline shows up here.',
  lblChapters: zh ? '章节' : 'chapters',
  lblWords: zh ? '字数' : 'chars',
};

const L = {
  pick: zh ? '选择或拖入一个 .epub 文件' : 'Choose or drop an .epub file',
  dropSub: zh ? '本地解析与转换，绝不上传。' : 'Parsed and converted locally — never uploaded.',
  metaTitle: zh ? '书籍信息' : 'Book info',
  titleLabel: zh ? '书名' : 'Title',
  titlePh: zh ? '默认取 EPUB 元数据' : 'Defaults to the EPUB metadata',
  authorLabel: zh ? '作者' : 'Author',
  authorPh: zh ? '佚名' : 'Unknown',
  optTitle: zh ? '输出选项' : 'Output options',
  optHeader: zh ? '在开头加上书名 / 作者' : 'Add a title / author header',
  optTitles: zh ? '每章前保留章节标题' : 'Keep a heading before each chapter',
  statsTitle: zh ? '章节目录预览' : 'Chapter outline',
  deviceLabel: zh ? '设备地址' : 'Device address',
  destLabel: zh ? '保存目录' : 'Save folder',
  probeBtn: zh ? '探测' : 'Probe',
  downloadBtn: zh ? '下载 TXT' : 'Download TXT',
  pushBtn: zh ? '推送到设备' : 'Push to device',
  offlineNote: zh
    ? '全部在你的浏览器本地完成，原文不上传。按 EPUB 阅读顺序（spine）抽取正文并转成纯文本，可下载进 SD 卡，或通过设备内置 Web 服务的 /upload 推送。'
    : 'Everything runs locally — nothing is uploaded. Body text is extracted in EPUB reading order (the spine) and converted to plain text; download it to the SD card, or push via the device’s built-in /upload endpoint.',
  footNote: zh
    ? '提示：转换会剥离样式与图片，只保留文字与段落。若某本书的章节标题藏在图片里，导出后可能为空标题。'
    : 'Tip: styling and images are stripped — only text and paragraph breaks remain. If a book hides chapter titles in images, those headings may come out empty.',
};
---

<section class="tx py-6 sm:py-8" data-e2t={JSON.stringify({ strings })}>
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        {/* Dropzone */}
        <div id="e2tDrop" class="tx-drop" tabindex="0" role="button" aria-label={strings.noFile}>
          <svg class="tx-drop-icon" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 6c-2-1.5-5-1.5-8 0v12c3-1.5 6-1.5 8 0 2-1.5 5-1.5 8 0V6c-3-1.5-6-1.5-8 0z M12 6v12" />
          </svg>
          <p class="tx-drop-title" id="e2tPick">{L.pick}</p>
          <p class="tx-drop-sub">{L.dropSub}</p>
          <span id="e2tFileName" class="tx-filename"></span>
        </div>
        <input id="e2tFile" type="file" accept=".epub,application/epub+zip" class="hidden" />

        {/* Book info */}
        <h2 class="tx-h2">{L.metaTitle}</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <label class="tx-field">
            <span class="tx-flabel">{L.titleLabel}</span>
            <input id="e2tTitle" type="text" placeholder={L.titlePh} class="tx-control" />
          </label>
          <label class="tx-field">
            <span class="tx-flabel">{L.authorLabel}</span>
            <input id="e2tAuthor" type="text" placeholder={L.authorPh} class="tx-control" />
          </label>
        </div>

        {/* Output options */}
        <h2 class="tx-h2">{L.optTitle}</h2>
        <div class="mt-3 grid gap-2.5">
          <label class="tx-check"><input id="e2tHeader" type="checkbox" checked /> <span>{L.optHeader}</span></label>
          <label class="tx-check"><input id="e2tTitles" type="checkbox" checked /> <span>{L.optTitles}</span></label>
        </div>
      </div>

      {/* Right column */}
      <div>
        <p id="e2tStats" class="tx-stats"></p>
        <h2 class="tx-h2 mt-4">{L.statsTitle}</h2>
        <pre id="e2tPreview" class="tx-preview mt-3">{strings.previewEmpty}</pre>

        {/* Device */}
        <div class="mt-8">
          <label class="tx-field">
            <span class="tx-flabel">{L.deviceLabel}</span>
            <div class="flex items-center gap-2">
              <input id="e2tDevice" type="text" value="http://192.168.4.1" class="tx-control flex-1" />
              <button id="e2tProbe" type="button" class="tx-btn tx-btn-ghost shrink-0">{L.probeBtn}</button>
            </div>
          </label>
          <label class="tx-field mt-3">
            <span class="tx-flabel">{L.destLabel}</span>
            <input id="e2tDest" type="text" value="/books" class="tx-control" />
          </label>
          <p id="e2tDeviceStatus" class="mt-2 font-mono text-xs text-ink/50"></p>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <button id="e2tDownload" type="button" class="tx-btn tx-btn-ghost">{L.downloadBtn}</button>
          <button id="e2tPush" type="button" class="tx-btn tx-btn-primary">{L.pushBtn}</button>
        </div>
        <p id="e2tStatus" class="mt-4 font-mono text-xs text-ink/60">{strings.ready}</p>
        <p class="mt-2 max-w-[60ch] text-xs/5 text-ink/45">{L.offlineNote}</p>
      </div>
    </div>

    <p class="mt-12 border-t border-ink/10 pt-4 text-xs/5 text-ink/40">{L.footNote}</p>
  </div>
</section>

<style>
  .tx-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
    cursor: pointer;
    border: 1.5px dashed color-mix(in oklab, var(--color-ink) 22%, transparent);
    border-radius: 16px;
    background: var(--color-surface);
    padding: 30px 20px;
    transition: border-color 0.16s ease, background 0.16s ease;
  }
  .tx-drop:hover,
  .tx-drop:focus-visible,
  .tx-drop.dragover {
    border-color: var(--color-accent-500);
    background: color-mix(in oklab, var(--color-accent-500) 6%, var(--color-surface));
    outline: none;
  }
  .tx-drop.has-file {
    padding: 14px 20px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }
  .tx-drop.has-file .tx-drop-icon,
  .tx-drop.has-file .tx-drop-sub {
    display: none;
  }
  .tx-drop.has-file .tx-drop-title::after {
    content: ' ✓';
    color: var(--color-accent-600);
  }
  .tx-drop-icon {
    color: var(--color-accent-600);
  }
  .tx-drop-title {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--color-ink);
  }
  .tx-drop-sub {
    font-size: 13px;
    color: color-mix(in oklab, var(--color-ink) 55%, transparent);
  }
  .tx-filename {
    font-family: var(--font-mono);
    font-size: 12px;
    color: color-mix(in oklab, var(--color-ink) 50%, transparent);
  }
  .tx-h2 {
    margin-top: 30px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-600);
  }
  .tx-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .tx-flabel {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-ink) 50%, transparent);
  }
  .tx-control {
    width: 100%;
    border: 1px solid color-mix(in oklab, var(--color-ink) 15%, transparent);
    background: #ffffff;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: var(--color-ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    outline: none;
    transition: border-color 0.16s ease, box-shadow 0.16s ease;
  }
  .tx-control:focus {
    border-color: var(--color-accent-500);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent-500) 25%, transparent);
  }
  .tx-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--color-ink);
    cursor: pointer;
  }
  .tx-check input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent-600);
  }
  .tx-stats {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-accent-600);
    min-height: 1.2em;
  }
  .tx-preview {
    max-height: 360px;
    overflow: auto;
    border: 1px solid color-mix(in oklab, var(--color-ink) 12%, transparent);
    border-radius: 12px;
    background: #ffffff;
    padding: 16px 18px;
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--color-ink);
  }
  .tx-btn {
    font-family: var(--font-mono);
    font-size: 13px;
    border-radius: 999px;
    padding: 9px 18px;
    cursor: pointer;
    transition: border-color 0.16s ease, background 0.16s ease, color 0.16s ease;
  }
  .tx-btn-ghost {
    border: 1px solid color-mix(in oklab, var(--color-ink) 20%, transparent);
    background: #ffffff;
    color: var(--color-ink);
  }
  .tx-btn-ghost:hover {
    border-color: var(--color-accent-500);
    color: var(--color-accent-600);
  }
  .tx-btn-primary {
    border: 1px solid var(--color-accent-600);
    background: var(--color-accent-600);
    color: var(--color-surface);
    font-weight: 600;
  }
  .tx-btn-primary:hover {
    background: var(--color-accent-700);
    border-color: var(--color-accent-700);
  }
</style>

<script>
  import { initEpub2Txt } from '../tools/epub2txt';

  const section = document.querySelector('[data-e2t]');
  if (section) {
    const props = JSON.parse(section.getAttribute('data-e2t') || '{}');
    initEpub2Txt(props);
  }
</script>
