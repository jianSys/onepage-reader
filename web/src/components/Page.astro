---
import type { Lang } from '../i18n/ui';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Materials from './Materials.astro';
import Footer from './Footer.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Nav lang={lang} />
<main>
  <Hero lang={lang} />

  <Materials lang={lang} />
</main>
<Footer lang={lang} />
