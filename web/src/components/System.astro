---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import { Image } from 'astro:assets';
import Logbook from './Logbook.astro';
import Capabilities from './Capabilities.astro';
import Specs from './Specs.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang].system;
const fe = ui[lang].features;

// Real firmware UI shots from src/assets/system, matched to the i18n captions by filename.
const shotFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/system/*.png', { eager: true });
const shotByName: Record<string, ImageMetadata> = {};
for (const p in shotFiles) shotByName[p.split('/').pop()!] = shotFiles[p].default;
const shots = s.shots
  .map((sh) => ({ ...sh, img: shotByName[sh.src] }))
  .filter((sh) => sh.img);
---

<section id="system" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.eyebrow}</p>
    <h1 class="mt-3 max-w-[20ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">{s.title}</h1>
    <p class="mt-4 max-w-[58ch] text-base/7 text-pretty text-ink/65" data-reveal style="--reveal-delay:160ms">{s.lede}</p>

    <h2 class="mt-16 font-mono text-sm font-medium tracking-wider text-ink/80 uppercase" data-reveal>{s.archTitle}</h2>
    <ol class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
      {s.layers.map((layer, i) => (
        <li class="flex gap-5 py-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="mt-1 font-mono text-xs text-ink/55">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-serif text-lg font-medium text-ink">{layer.name}</h3>
            <p class="mt-1 max-w-[58ch] text-sm/6 text-ink/65">{layer.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

{shots.length > 0 && (
<section class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-24">
  <div class="mx-auto max-w-5xl px-6">
    <h2 class="font-mono text-sm font-medium tracking-wider text-ink/80 uppercase" data-reveal>{s.shotsTitle}</h2>
    <div class="mt-10 grid gap-8 sm:grid-cols-3 sm:gap-6">
      {shots.map((sh, i) => (
        <figure class="m-0" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <div class="relative mx-auto aspect-[75/124] w-full max-w-[280px]">
            <img src={`${import.meta.env.BASE_URL}onepage-top.svg`} alt="" class="absolute inset-0 h-full w-full" />
            <Image
              src={sh.img}
              alt={sh.alt}
              widths={[480, 720, 960]}
              sizes="(min-width: 640px) 210px, 70vw"
              format="webp"
              quality={86}
              loading="lazy"
              class="absolute object-cover"
              style="left:12.95%;top:7.96%;width:73.44%;height:74.35%;border-radius:1.5%;box-shadow:inset 0 0 0 1px rgba(0,0,0,.22)"
            />
          </div>
          <figcaption class="mt-4">
            <p class="font-serif text-base font-medium text-ink">{sh.title}</p>
            <p class="mt-1 text-sm/6 text-ink/60">{sh.caption}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
)}

<!-- Capability grid: reading spotlight first, then the rest as a grid -->
<section id="features" class="scroll-mt-20 border-t border-ink/12 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl space-y-16 px-6">
    <Logbook lang={lang} {...fe.reading} id="reading" />
    <div class="rule-hair"></div>
    <Capabilities lang={lang} />
  </div>
</section>

<Specs lang={lang} />
