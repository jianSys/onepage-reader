---
import type { Lang } from '../i18n/ui';
import { ui } from '../i18n/ui';
import Logbook from './Logbook.astro';
import Capabilities from './Capabilities.astro';
import Specs from './Specs.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = ui[lang].system;
const fe = ui[lang].features;
---

<section id="system" class="scroll-mt-20 border-t border-ink/12 bg-surface py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6">
    <p class="font-mono text-xs tracking-wider text-accent-600 uppercase" data-reveal>{s.eyebrow}</p>
    <h1 class="mt-3 max-w-[20ch] font-serif text-3xl font-medium tracking-tight text-balance text-ink sm:text-4xl" data-reveal style="--reveal-delay:80ms">{s.title}</h1>
    <p class="mt-4 max-w-[58ch] text-base/7 text-pretty text-ink/65" data-reveal style="--reveal-delay:160ms">{s.lede}</p>

    <h2 class="mt-16 font-mono text-sm font-medium tracking-wider text-ink/80 uppercase" data-reveal>{s.archTitle}</h2>
    <ol class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
      {s.layers.map((layer, i) => (
        <li class="flex gap-5 py-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="mt-1 font-mono text-xs text-ink/55">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="font-serif text-lg font-medium text-ink">{layer.name}</h3>
            <p class="mt-1 max-w-[58ch] text-sm/6 text-ink/65">{layer.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- Capability grid: reading spotlight first, then the rest as a grid -->
<section id="features" class="scroll-mt-20 border-t border-ink/12 py-20 sm:py-28">
  <div class="mx-auto max-w-5xl space-y-16 px-6">
    <Logbook lang={lang} {...fe.reading} id="reading" />
    <div class="rule-hair"></div>
    <Capabilities lang={lang} />
  </div>
</section>

<Specs lang={lang} />
